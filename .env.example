# Placeholder names for local development only.
# Set production values in Netlify Project configuration > Environment variables.

PORT=8080

# Resend production email API. The sender must belong to a verified domain.
RESEND_API_KEY=re_replace_with_resend_api_key
RESEND_FROM_EMAIL=Resilia <appointments@your-verified-domain.com>

# Base64-encoded 32-byte AES-GCM key for encrypted appointment retention.
APPOINTMENT_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key

# Optional local-only SMTP settings used by server.py.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-local-smtp-account@example.com
SMTP_PASS=your-local-smtp-app-password
